generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  user
  admin
}

enum OtpPurpose {
  login
  phone_change
  email_verify
}

enum AuthProvider {
  google
  apple
}

enum AttemptStatus {
  started
  finished
  abandoned
  rejected
}

enum ScoreVerificationStatus {
  pending
  verified
  suspicious
}

enum BrandPackage {
  basic
  plus
  premium
}

enum CampaignStatus {
  draft
  active
  paused
  completed
}

enum BannerPlacement {
  home
  game_loading
  leaderboard
}

enum RewardClaimStatus {
  pending
  approved
  rejected
  delivered
}

enum PointBonusReason {
  registration
  daily_login
  email_verification
  phone_verification
  profile_completion
  referral_signup
  referral_invite
  level_up
  reward_engagement
}

enum MarketCoinTransactionType {
  earned_conversion
  spent_reward
  expired
}

enum AdminAuditAction {
  role_change
  manual_adjustment
}

model User {
  id             String          @id @default(cuid())
  phone          String?         @unique
  phoneVerifiedAt DateTime?
  email          String?         @unique
  emailVerifiedAt DateTime?
  displayName    String          @unique
  avatarUrl      String?
  birthDate      DateTime?
  interests      String[]        @default([])
  passwordHash   String?
  passwordSetAt  DateTime?
  referralCode   String?         @unique
  referredById   String?
  totalPoints    Int             @default(0)
  seasonScore    Int             @default(0)
  lifetimeScore  Int             @default(0)
  level          Int             @default(1)
  xp             Int             @default(0)
  totalXp        Int             @default(0)
  coins          Int             @default(14)
  marketCoins    Int             @default(0)
  role           UserRole        @default(user)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  otpCodes       OtpCode[]
  sessions       UserSession[]
  authAccounts   AuthAccount[]
  attempts       GameAttempt[]
  scores         Score[]
  pointBonuses   PointBonus[]
  seasonConversions SeasonConversion[]
  marketCoinTransactions MarketCoinTransaction[]
  rewardClaims   RewardClaim[]
  analyticsEvents AnalyticsEvent[]
  referredBy     User?           @relation("UserReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals      User[]          @relation("UserReferrals")

  @@index([role])
  @@index([referredById])
}

model AuthAccount {
  id             String       @id @default(cuid())
  provider       AuthProvider
  providerUserId String
  email          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([email])
  @@index([userId])
}

model PointBonus {
  id        String           @id @default(cuid())
  awardKey  String
  points    Int
  reason    PointBonusReason
  awardedAt DateTime         @default(now())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, awardKey])
  @@index([awardedAt])
  @@index([userId, awardedAt])
}

model SeasonConversion {
  id                 String   @id @default(cuid())
  seasonKey          String
  seasonScoreBefore  Int
  scoreConverted     Int
  marketCoinsAwarded Int
  conversionRate     Int
  scoreCap           Int
  convertedAt        DateTime @default(now())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, seasonKey])
  @@index([seasonKey, convertedAt])
  @@index([userId, convertedAt])
}

model MarketCoinTransaction {
  id           String                    @id @default(cuid())
  type         MarketCoinTransactionType
  amount       Int
  remainingAmount Int                    @default(0)
  source       String?
  referenceId  String?
  expiresAt    DateTime?
  createdAt    DateTime                  @default(now())
  userId       String
  user         User                      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([userId, type, createdAt])
  @@index([referenceId])
}

model OtpCode {
  id        String     @id @default(cuid())
  phone     String?
  email     String?
  codeHash  String
  purpose   OtpPurpose @default(login)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime   @default(now())
  userId    String?
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([phone, purpose, expiresAt])
  @@index([email, purpose, expiresAt])
}

model UserSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  revokedAt DateTime?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Game {
  id                String        @id @default(cuid())
  slug              String        @unique
  title             String
  description       String?
  iconUrl           String?
  iframeUrl         String?
  active            Boolean       @default(true)
  comingSoon        Boolean       @default(false)
  sortOrder         Int           @default(0)
  dailyAttemptLimit Int           @default(3)
  pointRatio        Float?
  scoringRule       Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  attempts          GameAttempt[]
  scores            Score[]
  campaigns         CampaignGame[]

  @@index([active, sortOrder])
}

model GameAttempt {
  id          String        @id @default(cuid())
  status      AttemptStatus @default(started)
  startedAt   DateTime      @default(now())
  finishedAt  DateTime?
  scoreToken  String        @unique
  clientMeta  Json?
  userId      String
  gameId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  game        Game          @relation(fields: [gameId], references: [id], onDelete: Cascade)
  score       Score?

  @@index([userId, gameId, startedAt])
  @@index([status])
}

model Score {
  id                 String                  @id @default(cuid())
  rawScore           Int
  playPoints         Int
  durationSeconds    Int
  hits               Int?
  misses             Int?
  accuracy           Int?
  maxCombo           Int?
  verificationStatus ScoreVerificationStatus @default(verified)
  suspiciousReason   String?
  createdAt          DateTime                @default(now())
  userId             String
  gameId             String
  attemptId          String?                 @unique
  user               User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  game               Game                    @relation(fields: [gameId], references: [id], onDelete: Cascade)
  attempt            GameAttempt?            @relation(fields: [attemptId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([gameId, createdAt])
  @@index([userId, createdAt])
  @@index([verificationStatus])
}

model AdminAuditLog {
  id             String           @id @default(cuid())
  action         AdminAuditAction
  adminUserId    String
  targetUserId   String
  metadata       Json?
  createdAt      DateTime         @default(now())

  @@index([targetUserId, createdAt])
  @@index([adminUserId, createdAt])
  @@index([action, createdAt])
}

model Brand {
  id            String     @id @default(cuid())
  name          String     @unique
  logoUrl       String?
  packageType   BrandPackage @default(basic)
  monthlyFeeGel Int
  contactName   String?
  contactPhone  String?
  notes         String?
  active        Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  campaigns     Campaign[]
  banners       Banner[]
  rewards       Reward[]
}

model Campaign {
  id        String           @id @default(cuid())
  title     String
  status    CampaignStatus   @default(draft)
  rulesText String?
  startsAt  DateTime
  endsAt    DateTime
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  brandId   String
  brand     Brand            @relation(fields: [brandId], references: [id], onDelete: Cascade)
  banners   Banner[]
  games     CampaignGame[]
  rewards   CampaignReward[]

  @@index([status, startsAt, endsAt])
}

model CampaignGame {
  id         String   @id @default(cuid())
  campaignId String
  gameId     String
  createdAt  DateTime @default(now())
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  game       Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([campaignId, gameId])
  @@index([gameId])
}

model CampaignReward {
  id         String   @id @default(cuid())
  campaignId String
  rewardId   String
  createdAt  DateTime @default(now())
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  reward     Reward   @relation(fields: [rewardId], references: [id], onDelete: Cascade)

  @@unique([campaignId, rewardId])
  @@index([rewardId])
}

model Banner {
  id          String          @id @default(cuid())
  title       String
  placement   BannerPlacement
  imageUrl    String
  clickUrl    String?
  active      Boolean         @default(true)
  startsAt    DateTime
  endsAt      DateTime
  impressions Int             @default(0)
  clicks      Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  brandId     String
  campaignId  String?
  brand       Brand           @relation(fields: [brandId], references: [id], onDelete: Cascade)
  campaign    Campaign?       @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([placement, active, startsAt, endsAt])
}

model Reward {
  id             String        @id @default(cuid())
  slug           String        @unique
  title          String
  description    String?
  imageUrl       String?
  category       String
  requiredPoints Int
  quantity       Int
  claimedCount   Int           @default(0)
  active         Boolean       @default(true)
  expiresAt      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  brandId        String
  brand          Brand         @relation(fields: [brandId], references: [id], onDelete: Cascade)
  claims         RewardClaim[]
  campaigns      CampaignReward[]
  auditLogs      RewardAuditLog[]

  @@index([active, requiredPoints])
  @@index([brandId])
}

model RewardAuditLog {
  id           String   @id @default(cuid())
  rewardId     String
  adminUserId  String
  changes      Json
  createdAt    DateTime @default(now())
  reward       Reward   @relation(fields: [rewardId], references: [id], onDelete: Cascade)

  @@index([rewardId, createdAt])
  @@index([adminUserId, createdAt])
}

model RewardClaim {
  id          String            @id @default(cuid())
  status      RewardClaimStatus @default(pending)
  pointsSpent Int
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  deliveredAt DateTime?
  userId      String
  rewardId    String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  reward      Reward            @relation(fields: [rewardId], references: [id], onDelete: Cascade)

  @@unique([userId, rewardId])
  @@index([status, createdAt])
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  name      String
  metadata  Json?
  createdAt DateTime @default(now())
  userId    String?
  brandId   String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([name, createdAt])
  @@index([userId, createdAt])
  @@index([brandId, createdAt])
}
